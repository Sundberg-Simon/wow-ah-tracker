# Blizzard API client (register a free client at https://develop.battle.net)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Region is fixed to eu for this project, but keep it explicit rather than hardcoded
BLIZZARD_REGION=eu

# Postgres connection string (Neon/Supabase free tier, or any Postgres)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Crafting optimizer backups (all optional). Backups always go to data-private/backups/ next to the
# local crafting DB; set this to ALSO copy each one to another drive or a cloud-synced folder, since a
# copy on the same disk can't survive losing the disk. Local only: this file is never committed.
# CRAFTING_BACKUP_EXTRA_DIR=D:\wow-ah-tracker-backups
