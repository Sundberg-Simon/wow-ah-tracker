{
  "name": "wow-ah-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted EU WoW auction house price tracker for a fixed list of items.",
  "type": "module",
  "scripts": {
    "sync": "tsx scripts/runSyncOnce.ts",
    "milestone1": "tsx scripts/milestone1.ts",
    "migrate": "tsx scripts/migrate.ts",
    "query": "tsx scripts/queryHistory.ts",
    "report": "tsx scripts/report.ts",
    "health": "tsx scripts/healthCheck.ts",
    "ingest": "tsx scripts/ingestSavedVariables.ts",
    "report:earnings": "tsx scripts/reportEarnings.ts",
    "rollup": "tsx scripts/rollupSnapshots.ts",
    "typecheck": "tsc --noEmit",
    "crafting": "tsx scripts/crafting.ts",
    "test:crafting": "node --import tsx --test src/crafting/*.test.ts",
    "test:sync": "node --import tsx --test src/sync/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "luaparse": "^0.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
